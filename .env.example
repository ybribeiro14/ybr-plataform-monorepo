# ═══════════════════════════════════════════════════════════════
# YBR Platform — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ⚠️  NUNCA commite o arquivo .env.local
# ═══════════════════════════════════════════════════════════════

# ─── Geral ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# ─── Banco de Dados (PostgreSQL / Neon) ──────────────────────
# Local (docker-compose):
DATABASE_URL=postgresql://ybr_user:ybr_local_pass@localhost:5432/ybr_platform_dev
# Produção (Neon serverless):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/ybr_platform?sslmode=require

# ─── Cache (Upstash Redis) ─────────────────────────────────
# Obtenha em: https://console.upstash.com/redis
# Plano gratuito disponível para desenvolvimento
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your_upstash_redis_token

# ─── Autenticação (JWT) ───────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_long_here

# ─── Stripe (Pagamentos) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Bunny Stream (Vídeo — Fase 1) ───────────────────────────
BUNNY_STREAM_API_KEY=...
BUNNY_VIDEO_LIBRARY_ID=...
BUNNY_VIDEO_PULL_ZONE_URL=https://vz-xxx.b-cdn.net/

# ─── Mux Video (Vídeo — Fase 2+) ─────────────────────────────
# MUX_TOKEN_ID=...
# MUX_TOKEN_SECRET=...
# MUX_WEBHOOK_SECRET=...

# ─── Cloudflare R2 (Storage) ──────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=ybr-platform
R2_PUBLIC_URL=https://r2.ybr-platform.com

# ─── Resend (Email Transacional) ──────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@ybr-platform.com

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ─── Frontend (Next.js — vars públicas) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_BUNNY_PULL_ZONE_URL=https://vz-xxx.b-cdn.net/
