{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/oauth2": "^8.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@upstash/redis": "^1.0.0",
    "@ybr/database": "workspace:*",
    "@ybr/schemas": "workspace:*",
    "@ybr/types": "workspace:*",
    "bcrypt": "^5.1.0",
    "csv-stringify": "^6.0.0",
    "dayjs": "^1.0.0",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^4.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "uuidv7": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
